# Server Port & MongoDB Connection
PORT=3000
MONGO_URI=

# JWT Authentication Config
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL_DAYS=

# OTP Settings
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Gmail SMTP Configuration
# Note: For Gmail, use an App Password (16 characters) generated from your Google Account settings:
# Google Account -> Security -> 2-Step Verification -> App passwords

SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
